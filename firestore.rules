rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Test connection doc
    match /test/{docId} {
      allow get: if true;
    }

    // Transaction validation
    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'category', 'description', 'date', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'type', 'amount', 'category', 'description', 'date', 'createdAt', 'updatedAt']) &&
        data.userId == request.auth.uid &&
        (data.type == 'income' || data.type == 'expense') &&
        data.amount is number && data.amount >= 0 && data.amount <= 1000000000 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 64 &&
        data.description is string && data.description.size() <= 256 &&
        data.date is string && data.date.size() == 10 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidId(transactionId) && 
                    existing().userId == request.auth.uid && 
                    incoming().userId == existing().userId && 
                    incoming().createdAt == existing().createdAt && 
                    isValidTransaction(incoming());
      allow delete: if isSignedIn() && isValidId(transactionId) && existing().userId == request.auth.uid;
    }

    // Budget validation
    function isValidBudget(data) {
      return data.keys().hasAll(['userId', 'month', 'category', 'limitAmount', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'month', 'category', 'limitAmount', 'createdAt', 'updatedAt']) &&
        data.userId == request.auth.uid &&
        data.month is string && data.month.size() == 7 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 64 &&
        data.limitAmount is number && data.limitAmount >= 0 && data.limitAmount <= 1000000000 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    match /budgets/{budgetId} {
      allow get: if isSignedIn() && isValidId(budgetId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(budgetId) && isValidBudget(incoming());
      allow update: if isSignedIn() && isValidId(budgetId) && 
                    existing().userId == request.auth.uid && 
                    incoming().userId == existing().userId && 
                    incoming().createdAt == existing().createdAt && 
                    isValidBudget(incoming());
      allow delete: if isSignedIn() && isValidId(budgetId) && existing().userId == request.auth.uid;
    }
  }
}
